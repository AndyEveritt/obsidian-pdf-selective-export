# vscode
.vscode 

# Intellij
*.iml
.idea

# npm
node_modules

# Don't include the compiled main.js file in the repo.
# They should be uploaded to GitHub releases instead.
main.js

# Exclude sourcemaps
*.map

# obsidian
data.json

# Exclude macOS Finder (System Explorer) View States
.DS_Store

# Demo vault: build output, workspace state and exported PDFs
demo-vault/.obsidian/plugins/*/main.js
demo-vault/.obsidian/plugins/*/manifest.json
demo-vault/.obsidian/plugins/*/styles.css
demo-vault/.obsidian/workspace*.json
demo-vault/**/*.pdf
